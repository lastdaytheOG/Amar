package com.amar.vault.agent.control.executors

import android.content.Context
import android.content.Intent
import android.content.pm.ActivityInfo
import android.content.pm.ApplicationInfo
import android.content.pm.PackageInfo
import android.content.pm.ResolveInfo
import androidx.test.core.app.ApplicationProvider
import com.amar.vault.agent.control.ExecutionResult
import com.amar.vault.agent.control.FailureReason
import com.amar.vault.agent.control.TaskContext
import com.amar.vault.agent.dsl.ActionEnvelope
import com.amar.vault.agent.dsl.AgentAction
import com.amar.vault.agent.perception.PackageWatchlist
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.test.runTest
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Before
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.RobolectricTestRunner
import org.robolectric.Shadows.shadowOf

/**
 * Robolectric-backed tests for intent-tier executors.
 *
 * We test:
 *   - OpenApp: package resolution, explicit packageId, label scan, launch behavior,
 *     watchlist acquire/release on failure.
 *   - SendMessage: WhatsApp/Telegram deep link construction, package pinning,
 *     phone-vs-handle routing for Telegram.
 *
 * Robolectric provides a working PackageManager we can prime with installed
 * apps. Intent launches go to a ShadowActivityManager we can introspect.
 */
@OptIn(ExperimentalCoroutinesApi::class)
@RunWith(RobolectricTestRunner::class)
class IntentExecutorsTest {

    private lateinit var context: Context
    private lateinit var watchlist: PackageWatchlist

    @Before
    fun setUp() {
        context = ApplicationProvider.getApplicationContext()
        watchlist = PackageWatchlist()
    }

    private fun ctxFor(envelope: ActionEnvelope) = TaskContext.create(envelope)

    private fun installPackage(pkgName: String, label: String? = null) {
        val pm = shadowOf(context.packageManager)

        // Register the package itself.
        val pkgInfo = PackageInfo().apply {
            packageName = pkgName
            applicationInfo = ApplicationInfo().apply {
                packageName = pkgName
                nonLocalizedLabel = label ?: pkgName
            }
        }
        pm.installPackage(pkgInfo)

        // Register a launcher activity so getLaunchIntentForPackage works.
        val launchIntent = Intent(Intent.ACTION_MAIN)
            .addCategory(Intent.CATEGORY_LAUNCHER)
            .setPackage(pkgName)

        val resolveInfo = ResolveInfo().apply {
            activityInfo = ActivityInfo().apply {
                packageName = pkgName
                name = "$pkgName.MainActivity"
                applicationInfo = pkgInfo.applicationInfo
                nonLocalizedLabel = label ?: pkgName
            }
        }
        pm.addResolveInfoForIntent(launchIntent, resolveInfo)
    }

    // -------------------------------------------------------------------------
    // OpenAppExecutor
    // -------------------------------------------------------------------------

    @Test
    fun `open_app with explicit packageId launches when installed`() = runTest {
        installPackage("com.whatsapp")
        val executor = OpenAppExecutor(context, watchlist)

        val envelope = ActionEnvelope(
            action = AgentAction.OpenApp(app = "WhatsApp", packageId = "com.whatsapp")
        )
        val result = executor.execute(envelope.action, ctxFor(envelope))

        assertTrue("expected Executed, got $result", result is ExecutionResult.Executed)
        assertEquals("com.whatsapp", (result as ExecutionResult.Executed).resultData["package"])
        assertTrue("watchlist acquired com.whatsapp", watchlist.allows("com.whatsapp"))
    }

    @Test
    fun `open_app with explicit packageId falls through when not installed`() = runTest {
        // No installPackage call — explicit packageId is not installed.
        val executor = OpenAppExecutor(context, watchlist)

        val envelope = ActionEnvelope(
            action = AgentAction.OpenApp(app = "WhatsApp", packageId = "com.whatsapp.notinstalled")
        )
        val result = executor.execute(envelope.action, ctxFor(envelope))

        // Should attempt hardcoded map → label scan → fail.
        assertTrue(result is ExecutionResult.Failed)
        assertTrue(
            (result as ExecutionResult.Failed).reason is FailureReason.TargetNotFound
        )
    }

    @Test
    fun `open_app uses hardcoded alias map for common apps`() = runTest {
        installPackage("com.whatsapp")
        val executor = OpenAppExecutor(context, watchlist)

        // No packageId — should resolve via hardcoded map ("whatsapp" → com.whatsapp).
        val envelope = ActionEnvelope(action = AgentAction.OpenApp(app = "whatsapp"))
        val result = executor.execute(envelope.action, ctxFor(envelope))

        assertTrue(result is ExecutionResult.Executed)
        assertEquals("com.whatsapp", (result as ExecutionResult.Executed).resultData["package"])
    }

    @Test
    fun `open_app is case insensitive on alias map`() = runTest {
        installPackage("com.whatsapp")
        val executor = OpenAppExecutor(context, watchlist)

        for (variant in listOf("WhatsApp", "WHATSAPP", "WhAtSaPp")) {
            val fresh = OpenAppExecutor(context, PackageWatchlist())
            val envelope = ActionEnvelope(action = AgentAction.OpenApp(app = variant))
            val result = fresh.execute(envelope.action, ctxFor(envelope))
            assertTrue("variant='$variant' should resolve — got $result",
                result is ExecutionResult.Executed)
        }
    }

    @Test
    fun `open_app fails when no package resolves`() = runTest {
        val executor = OpenAppExecutor(context, watchlist)

        val envelope = ActionEnvelope(action = AgentAction.OpenApp(app = "completely_made_up_app"))
        val result = executor.execute(envelope.action, ctxFor(envelope))

        assertTrue(result is ExecutionResult.Failed)
        val failed = result as ExecutionResult.Failed
        assertTrue(failed.reason is FailureReason.TargetNotFound)
        assertEquals("completely_made_up_app", (failed.reason as FailureReason.TargetNotFound).target)
    }

    @Test
    fun `open_app rejects wrong action type`() = runTest {
        val executor = OpenAppExecutor(context, watchlist)
        val envelope = ActionEnvelope(action = AgentAction.Home)
        val result = executor.execute(AgentAction.Home, ctxFor(envelope))
        assertTrue(result is ExecutionResult.FatalFailure)
    }

    // -------------------------------------------------------------------------
    // SendMessageExecutor
    // -------------------------------------------------------------------------

    @Test
    fun `send_message whatsapp fails when WhatsApp not installed`() = runTest {
        val executor = SendMessageExecutor(context, watchlist)

        val envelope = ActionEnvelope(action = AgentAction.SendMessage(
            app = "whatsapp", to = "919876543210", content = "hi"
        ))
        val result = executor.execute(envelope.action, ctxFor(envelope))

        assertTrue(result is ExecutionResult.Failed)
        val msg = ((result as ExecutionResult.Failed).reason as FailureReason.SystemError).detail
        assertTrue("error should mention app not installed: $msg",
            msg.contains("not installed") || msg.contains("resolves"))
    }

    @Test
    fun `send_message whatsapp rejects malformed phone numbers`() = runTest {
        val executor = SendMessageExecutor(context, watchlist)

        val envelope = ActionEnvelope(action = AgentAction.SendMessage(
            app = "whatsapp", to = "notanumber", content = "hi"
        ))
        val result = executor.execute(envelope.action, ctxFor(envelope))

        assertTrue(result is ExecutionResult.Failed)
        assertTrue((result as ExecutionResult.Failed).reason is FailureReason.TargetNotFound)
    }

    @Test
    fun `send_message telegram rejects phone numbers (tg needs username)`() = runTest {
        val executor = SendMessageExecutor(context, watchlist)

        val envelope = ActionEnvelope(action = AgentAction.SendMessage(
            app = "telegram", to = "+919876543210", content = "hi"
        ))
        val result = executor.execute(envelope.action, ctxFor(envelope))

        assertTrue(result is ExecutionResult.Failed)
        assertTrue((result as ExecutionResult.Failed).reason is FailureReason.TargetNotFound)
    }

    @Test
    fun `send_message returns TargetNotFound for unsupported apps`() = runTest {
        val executor = SendMessageExecutor(context, watchlist)

        val envelope = ActionEnvelope(action = AgentAction.SendMessage(
            app = "signal", to = "+919876543210", content = "hi"
        ))
        val result = executor.execute(envelope.action, ctxFor(envelope))

        // Signal has no deep link pattern in v1 — Brain should decompose.
        assertTrue(result is ExecutionResult.Failed)
        assertTrue((result as ExecutionResult.Failed).reason is FailureReason.TargetNotFound)
    }

    @Test
    fun `send_message rejects wrong action type`() = runTest {
        val executor = SendMessageExecutor(context, watchlist)
        val envelope = ActionEnvelope(action = AgentAction.Home)
        val result = executor.execute(AgentAction.Home, ctxFor(envelope))
        assertTrue(result is ExecutionResult.FatalFailure)
    }
}